<?xml version="1.0" encoding="UTF-8"?>
<!-- Aplicação de exemplo VENDAS (fictícia, para testes). Não contém código de cliente. -->
<Module version="120000" xmlns="http://xmlns.oracle.com/Forms">
  <FormModule Name="HISTORICO" Title="Histórico de Preços" FirstNavigationBlockName="HIS">
    <Trigger Name="WHEN-NEW-FORM-INSTANCE" TriggerText="go_block('HIS');&#10;execute_query;"/>
    <Trigger Name="KEY-EXIT" TriggerText="exit_form;"/>
    <Block Name="HIS" QueryDataSourceName="VND_HISTORICO_PRECOS" RecordsDisplayCount="15" WhereClause="produto_id = :global.produto_id" OrderByClause="dt_alteracao desc" InsertAllowed="false" UpdateAllowed="false" DeleteAllowed="false">
      <Item Name="ID" ItemType="Text Item" DataType="Number" PrimaryKey="true" Visible="false"/>
      <Item Name="PRODUTO_ID" ItemType="Text Item" DataType="Number" Visible="false"/>
      <Item Name="DT_ALTERACAO" ItemType="Text Item" DataType="Date" Prompt="Data"/>
      <Item Name="PRECO_ANTERIOR" ItemType="Text Item" DataType="Number" Prompt="Preço anterior"/>
      <Item Name="PRECO_NOVO" ItemType="Text Item" DataType="Number" Prompt="Preço novo"/>
      <Item Name="USUARIO" ItemType="Text Item" DataType="Char" MaximumLength="30" Prompt="Usuário"/>
    </Block>
    <Canvas Name="CV_HIST" CanvasType="Content"/>
  </FormModule>
</Module>
